        {
          "id": "113e2163-cdcf-4b11-a982-41fad16c8ab7",
          "name": "Retrieve multiple parcel documents",
          "request": {
            "name": "Retrieve multiple parcel documents",
            "description": {
              "content": "Download multiple parcel documents of the same type in bulk.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parcel-documents",
                ":type"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "parcels",
                  "value": "<integer>",
                  "description": "(Required) Parcels for which you want to retrieve the documents"
                },
                {
                  "disabled": false,
                  "key": "paper_size",
                  "value": "<string>",
                  "description": "The paper size of the document you would like to retrieve. Paper size can be one of:\n\n- A4\n- A5\n- A6\n\nOmitting this query parameter leads to the internal paper size of the document being used. Generally this is A6 for labels and A4 for larger documents, like customs documents.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "type",
                  "description": "(Required) Document type you want to retrieve."
                }
              ]
            },
            "header": [
