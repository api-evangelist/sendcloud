{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shipments Address Broadcast API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Broadcast",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Broadcast test event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://panel.sendcloud.sc/api/v3/event-subscriptions/broadcast/test/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path",
                "description": "The id of the subscription to send a test event to."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Send a test event to the connection endpoint configured for a specific subscription. Use this to verify that your connection is set up correctly before relying on it for production events."
        }
      ]
    }
  ],
  "bundled": true
}