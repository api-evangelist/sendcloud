          "name": "Start OAuth2 authorization",
          "request": {
            "name": "Start OAuth2 authorization",
            "description": {
              "content": "Initiate the OAuth2 authorization flow for a connection that requires it (e.g., Klaviyo). Returns an authorization URL to redirect the user to.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "event-subscriptions",
                "connections",
                ":id",
                "authorization"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) The id of the connection to authorize."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
